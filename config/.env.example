# 邮件 SMTP（示例：QQ 邮箱）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=your@qq.com

# WPUSH 微信（https://docs.wpush.cn 注册，在个人消息页获取 apikey）
WPUSH_APIKEY=your_wpush_apikey
# 可选：wechat | webhook | feishu | dingtalk | wechat_work | mail | sms | app
WPUSH_CHANNEL=wechat

# 数据库（项目专用账号 + 独立 schema，勿使用 postgres 超级用户）
# 首次部署见 scripts/init_postgres.sh
# DATABASE_URL=postgresql+psycopg://quant_picker:your_app_password@127.0.0.1:5432/quant_picker

# TickFlow 行情（https://tickflow.org 注册获取 API Key）
# 未设置时使用免费服务（仅历史日K，不含 60分/1分）
# TICKFLOW_API_KEY=your-tickflow-api-key
