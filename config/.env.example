# =============================================================================
# 部署配置模板：复制为 config/.env 后按环境修改
#
#   cp config/.env.example config/.env
#
# 这里放「换一台机器就要改」的配置。策略、回测、仓位等跨环境一致的参数
# 仍在 config/settings.yaml，迁移部署时不用动。
# 真实的 config/.env 已被 .gitignore 忽略，不要提交。
# =============================================================================

# --- 数据库 ------------------------------------------------------------------
# 默认 SQLite，什么都不用配，开箱即用（1C2G 小服务器推荐）。
# 数据文件位置，相对路径以项目根目录为基准。
QUANT_PICKER_DB_PATH=data/quant_picker.db

# SQLite 并发：web 与 scheduler 是两个进程，都会写库。
# 已自动开启 WAL；这里是等待另一个写进程的秒数，写冲突频繁可调大。
QUANT_PICKER_SQLITE_TIMEOUT=30

# 切换到 PostgreSQL：取消下面两行注释即可，其余配置不变。
# 首次建库见 scripts/init_postgres.sh（专用账号 + 独立 schema，勿用 postgres 超级用户）。
# DATABASE_URL=postgresql+psycopg://quant_picker:your_db_password@127.0.0.1:5432/quant_picker
# QUANT_PICKER_DB_SCHEMA=quant_picker

# PostgreSQL 兜底：自动断开空闲事务超过该秒数的连接。这类连接会一直持有表锁，
# 足以卡死启动时的结构升级。设为 0 关闭。
QUANT_PICKER_PG_IDLE_TX_TIMEOUT=120

# --- 账号与密钥 --------------------------------------------------------------
# 用户推送凭据的加密密钥。首次启动会自动生成并写回本文件。
# 丢失后所有已保存的 SMTP 密码 / WPUSH apikey 都无法解密，请随备份一起保存。
# QUANT_PICKER_SECRET_KEY=

# 首次启动创建的管理员账号。不设密码则随机生成，写入
# data/bootstrap_admin_password.txt，登录后请立即在「账号管理」页修改。
QUANT_PICKER_ADMIN_USERNAME=admin
# QUANT_PICKER_ADMIN_PASSWORD=

# --- 行情数据源 --------------------------------------------------------------
# TickFlow（https://tickflow.org 注册获取）。
# 不配置则走免费服务，只有历史日K，没有 60分/1分。
# TICKFLOW_API_KEY=your-tickflow-api-key

# --- 推送 --------------------------------------------------------------------
# 这里没有推送配置，这是有意为之。
# SMTP 账号和 WPUSH APIKEY 属于每个用户自己，登录后在「推送设置」页填写，
# 加密存进数据库。放在 .env 里会变成全局共享，新用户会继承别人的邮箱和 APIKEY。

# --- 运行时 ------------------------------------------------------------------
# 定时任务时区，同时用于推送时间判断
QUANT_PICKER_TIMEZONE=Asia/Shanghai

# 后台自动更新的 K 线周期，逗号分隔。
# 1C2G 机器建议只留 1d；加入 1h/1m 会显著增加内存与请求量。
QUANT_PICKER_AUTO_SYNC_INTERVALS=1d

# 日志级别：DEBUG / INFO / WARNING / ERROR
QUANT_PICKER_LOG_LEVEL=INFO
